# Die schema.sql wird nur einmalig manuell in phpMyAdmin importiert und muss
# nicht über den Webserver erreichbar sein.
<FilesMatch "\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
